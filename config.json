{
  "api": {
    "base_url": "",
    "endpoints": {},
    "timeout": 6,
    "retry_attempts": 2
  },

  "tor": {
    "rotate_seconds": 300,
    "strict_nodes": true,
    "bootstrap_timeout": 240,
    "verify_max_retries": 15,
    "verify_retry_sleep": 4,
    "circuit_settle_sleep": 6,
    "parallel_bootstrap": true,
    "parallel_verify": true,

    "exclude_countries": ["ir", "kp", "cn", "ru", "sy", "cu", "ve", "ua", "by", "uz", "kz", "tm", "kg", "tj", "az", "am", "ge", "md"],

    "countries": [
