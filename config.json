  "xui": {
    "internal_port": 2053,
    "web_base_path": "/managepanel",
    "default_username": "admin",
    "default_password": "admin"
  },

  "direct": {
    "enabled": true,
    "port": 8080,
    "path": "/direct",
    "tag": "direct-inbound"
  },

  "server": {
    "public_port": 3000
  }
